# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=curator
DATABASE_URL=postgresql+psycopg://curator:curator@localhost:5432/curator
DATA_DIR=data/datasets
IMPORT_DIR=data/import
ACCESS_TOKEN_MINUTES=480
MAX_UPLOAD_BYTES=1073741824
# JSON array of frontend origins, including the development port when applicable.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Set to the trusted proxy address(es) when serving behind HTTPS; see DEPLOYMENT.md.
FORWARDED_ALLOW_IPS=127.0.0.1
